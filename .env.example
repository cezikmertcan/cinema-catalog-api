NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/cinema_catalog
REDIS_URL=redis://127.0.0.1:6379
AUTH_JWT_SECRET=local-development-secret-change-before-production
AUTH_JWT_ISSUER=cinema-catalog-api
AUTH_JWT_AUDIENCE=cinema-catalog-api-client
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REDIS_PREFIX=cinema-catalog:auth

# Used by the integration test suite. The test database is dropped before each test.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/cinema_catalog_test
TEST_REDIS_URL=redis://127.0.0.1:6379
